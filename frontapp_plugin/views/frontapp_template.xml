<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="frontapp_plugin.frontapp-plugin" name="FrontApp Plugin">
        <t t-call="web.layout">
            <t t-set="head_frontapp_plugin">
                <script type="text/javascript">
                    odoo.__session_info__ = <t t-out="json.dumps(session_info)"/>;
                    odoo.loadMenusPromise = Promise.resolve();
                    odoo.csrf_token = <t t-out="json.dumps(request.csrf_token())"/>;
                </script>
<!--                <base target="_parent"/>-->
                <t t-call-assets="frontapp_plugin.assets"/>
            </t>
            <t t-set="head" t-value="head_frontapp_plugin + (head or '')"/>
        </t>

    </template>
</odoo>
