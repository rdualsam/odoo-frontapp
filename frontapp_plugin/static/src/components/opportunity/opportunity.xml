<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="frontapp_plugin.Opportunity">
        <div
            t-attf-class="border m-1 p-2 {{ props.opportunity.isLinked ? 'border-secondary' : '' }}"
        >
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="fa fa-rocket" />
                    <a class="pl-1" t-att-href="props.opportunity.href" target="_blank">
                        <t t-esc="props.opportunity.name" />
                    </a>
                </div>
                <div>
                    <input
                        type="checkbox"
                        t-att-checked="props.opportunity.isLinked"
                        t-att-id="props.opportunity.id"
                        t-on-click="toggleOpportunityLink"
                        class="btn-check"
                    />
                    <label
                        class="btn mb-0 btn-odoo-outline is-linked-btn"
                        t-att-for="props.opportunity.id"
                    >
                        <i class="fa fa-paperclip" />
                    </label>
                </div>
            </div>
            <div class="ml-2" t-if="props.opportunity.stage_id">
                <span
                    class="tag opportunity-stage"
                    t-esc="props.opportunity.stage_id[1]"
                />
            </div>
            <t t-set="starIndex" t-value="0" />
            <div>
                <t
                    t-foreach="[...Array(props.opportunity.stars).keys()]"
                    t-key="starIndex"
                >
                    <i class="fa fa-star pl-1" />
                    <t t-set="starIndex" t-value="starIndex + 1" />
                </t>
            </div>
        </div>
    </t>
</templates>
