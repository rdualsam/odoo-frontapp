<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="frontapp.App">
        <div class="frontapp-odoo">
            <div>
                <div class="input-group input-group-sm">
                    <input class="form-control" id="search_input" placeholder="Search for Odoo contact" t-on-keyup="searchContact" t-ref="add-input"/>
                    <button class="btn btn-primary">
                        <i class="fa fa-search" t-on-click="searchContact"/>
                    </button>
                </div>
<!--                <button>-->
<!--                    <i class="fa fa-search" t-on-click="searchContact"/>-->
<!--                </button>-->
<!--                <input id="search_input" placeholder="Search for Odoo contact" t-on-keyup="searchContact" t-ref="add-input"/>-->
            </div>

            <div>
                <button t-on-click="createContact" class="btn btn-secondary m-1 d-block mx-auto">
<!--                    <i class="fa fa-save"/>-->
                    Create Contact (FirstName LastName)
                </button>
            </div>

                <div>
                <button t-on-click="createCompany" class="btn btn-secondary m-1 d-block mx-auto">
<!--                    <i class="fa fa-save"/>-->
                    Create Company
                </button>
            </div>

<!--            <div class="contact-panel" t-if="contacts.length">-->
<!--                <a style="float:right" href="/web/session/logout?redirect=/frontapp-plugin">Logout</a>-->
<!--                <div>-->
<!--                    <i class="fa fa-filter"/>-->
<!--                        <span class="pl-1" t-foreach="['all', 'linked']"-->
<!--                              t-as="f" t-key="f"-->
<!--                              t-att-class="{active: filter.value===f}"-->
<!--                              t-on-click="setFilter(f)"-->
<!--                              t-esc="f"/>-->
<!--                </div>-->
<!--            </div>-->

            <div id="error" t-ref="error" class="text-center"></div>

            <div id="login" style="display:none;" class="mt-10" t-ref="login">
                <form class="oe_login_form" role="form" method="post" onsubmit="this.action = '/web/login' + location.hash"
                      action="/web/login">
<!--                    <input type="hidden" name="csrf_token" id="csrf_token"/>-->
                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>

                    <div class="form-group field-login">
                        <label for="login">Login</label>
                        <input type="text" placeholder="Login" name="login" id="login" required="required" autofocus="autofocus"
                               autocapitalize="off" class="form-control "/>
                    </div>

                    <div class="form-group field-password">
                        <label for="password">Password</label>
                        <input type="password" placeholder="Password" name="password" id="password" required="required"
                               autocomplete="current-password" maxlength="4096" class="form-control "/>
                    </div>

                    <div class="clearfix oe_login_buttons text-center mb-1 pt-3">
                        <button type="submit" class="btn btn-primary btn-block">Connexion</button>
                    </div>
                    <input type="hidden" name="redirect" value="/frontapp-plugin"/>
                </form>
            </div>

            <div id="info"></div>

            <div id="contacts" t-ref="contacts" class="contact-list">
                <t t-foreach="contacts" t-as="contact" t-key="contact.id">
                    <Contact contact="contact"/>
                </t>
            </div>

<!--            <div class="contact-list">-->
<!--                <Contact t-foreach="displayedContacts" t-as="contact" t-key="contact.id" contact="contact"/>-->
<!--            </div>-->
        </div>
    </t>
</templates>


